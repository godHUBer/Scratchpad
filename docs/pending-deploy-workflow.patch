@@ -70,17 +70,35 @@ jobs:
       # A build with an empty VITE_SUPABASE_URL renders a "not configured"
       # screen instead of the app. Catch that here rather than in the browser.
       - name: Verify bundle has configuration baked in
+        # The host used to be hard-coded here. Once a fork or an owner set their
+        # own VITE_SUPABASE_URL repository variable, the build was correct but
+        # this step still grepped for the original project's host and failed the
+        # deploy. Derive it from the same source of truth the build used.
+        env:
+          EXPECTED_URL: ${{ vars.VITE_SUPABASE_URL }}
         run: |
-          echo "dist/index.html:"
-          cat dist/index.html
-          if ! grep -rq "lkxygnbvkdlwacbcbott.supabase.co" dist/assets/*.js; then
-            echo "::error::No Supabase URL found in the built bundle. Check .env.production / repository variables."
+          if [ -n "$EXPECTED_URL" ]; then
+            host=$(printf '%s' "$EXPECTED_URL" | sed -E 's#^https?://##; s#/+$##')
+          else
+            host=$(grep -E '^VITE_SUPABASE_URL=' .env.production | head -1 | cut -d= -f2- | sed -E 's#^https?://##; s#/+$##')
+          fi
+          if [ -z "$host" ]; then
+            echo "::error::No Supabase URL found in the environment or .env.production."
+            exit 1
+          fi
+          echo "expecting host: $host"
+          if ! grep -rqF "$host" dist/assets/*.js; then
+            echo "::error::The built bundle does not contain $host. Check .env.production / repository variables."
+            exit 1
+          fi
+          if ! grep -rqE 'sb_publishable_|eyJhbGciOi' dist/assets/*.js; then
+            echo "::error::No publishable key found in the built bundle."
             exit 1
           fi
           echo "configuration present in bundle"
 
       - name: Upload artifact
-        uses: actions/upload-pages-artifact@v3
+        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3
         with:
           path: dist
 
